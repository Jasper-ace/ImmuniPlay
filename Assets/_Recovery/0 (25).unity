  dialogues:
  - speaker: 0
    text: SIGH...
    facing: 0
  - speaker: 1
    text: MARIA ARE YOU OKAY?
    facing: 0
  - speaker: 1
    text: SHOULD WE REST FOR A BIT?
    facing: 0
  - speaker: 0
    text: IT'S OKAY.
    facing: 1
  - speaker: 0
    text: I'M JUST...
    facing: 1
  - speaker: 0
    text: A LITTLE NERVOUS.
    facing: 1
  - speaker: 0
    text: I WANT OUR BABY TO BE HEALTHY.
    facing: 1
  - speaker: 1
    text: DON'T WORRY.
    facing: 0
  - speaker: 1
    text: YOU AND THE BABY WILL DO GREAT.
    facing: 0
  - speaker: 1
    text: REMEMBER...
    facing: 0
  - speaker: 1
    text: WHATEVER HAPPENS...
    facing: 0
  - speaker: 1
    text: I'LL ALWAY BE BY YOUR SIDE.
    facing: 0
  - speaker: 0
    text: THANK YOU ANDREW.
    facing: 1
  - speaker: 0
    text: FOR ALWAYS BEING THERE.
    facing: 1
