  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CharacterManager
  characterCardPrefab: {fileID: 2183344197929967118, guid: d21e4ff0ae0e2d64fa47ff8d3a4a41b9, type: 3}
  content: {fileID: 421190960}
  characters:
  - characterName: MARIA
    role: MOTHER
    description: A caring and devoted mother who wants to make the best choices for
      her child's health and well-being. As she learns more about childhood immunization,
      she becomes more confident in caring for her child.
    characterImage: {fileID: 21300000, guid: e0092885a0dfc704c9418facc83f220f, type: 3}
    roleColor: {r: 0.9960785, g: 0.45098042, b: 0.4901961, a: 1}
    animatorController: {fileID: 9100000, guid: bb2dca740fc085a4c95a5d21b634ca9c, type: 2}
  - characterName: ANDREW
    role: FATHER
    description: A supportive and caring father who wants to provide the best for
      his family. As he learns more about childhood immunization, he becomes more
      informed and confident in supporting his child's health and well-being.
    characterImage: {fileID: 21300000, guid: c4540836c427dc54180ed0449a5c2f8f, type: 3}
    roleColor: {r: 0.454902, g: 0.68235296, b: 0.8745099, a: 1}
    animatorController: {fileID: 9100000, guid: 262b86a1a8a62fe40987824f1ebfbdb3, type: 2}
  - characterName: ANA
    role: NURSE
    description: A friendly and compassionate healthcare worker who helps parents
      understand prenatal care and childhood immunization. She provides guidance
      and support to help families make informed decisions about their child's health.
    characterImage: {fileID: 21300000, guid: 28f7b9389a469c24faba27c2185c03e3, type: 3}
    roleColor: {r: 0.58431375, g: 0.19215688, b: 0.6313726, a: 1}
    animatorController: {fileID: 9100000, guid: 26874a18db481ca478e4dfe0794c10bf, type: 2}
  - characterName: 'DR. CRUZ '
    role: PEDIATRICIAN
    description: A friendly and knowledgeable pediatrician who cares for children
      and helps parents understand childhood immunization and proper healthcare.
      He provides guidance and support to help families make informed decisions about
      their child's health and well-being.
    characterImage: {fileID: 21300000, guid: 6aebfe34f81372f4a811c7d4d538173f, type: 3}
    roleColor: {r: 0.2508864, g: 0.6301887, b: 0.562403, a: 1}
    animatorController: {fileID: 9100000, guid: 124a910f25f4eb44e91a22dea3f58567, type: 2}
  descriptionPanel: {fileID: 26087654}
  descriptionImage: {fileID: 453034741}
  descriptionAnimator: {fileID: 453034743}
  descriptionName: {fileID: 1805904012}
  descriptionText: {fileID: 235029167}
