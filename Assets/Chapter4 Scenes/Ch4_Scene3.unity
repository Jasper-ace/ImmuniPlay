    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 0cf386f76de4a16428e56b1d0de3be44, type: 3}
  - text: NURSE, WHAT ARE THESE VACCINES?
