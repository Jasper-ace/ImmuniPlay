  - characterName: MARIA
    dialogueBubble: {fileID: 2027462540}
    dialogueText: {fileID: 831931185}
    characterRoot: {fileID: 1532666067}
    characterImage: {fileID: 1189073847}
    characterShadow: {fileID: 2060202346}
    autoSize: {fileID: 2027462543}
    popAnimation: {fileID: 2027462542}
    triangleAnimation: {fileID: 588772580}
    animator: {fileID: 1189073849}
    shadowAnimator: {fileID: 2060202345}
  - characterName: ANDREW
    dialogueBubble: {fileID: 2034135706}
    dialogueText: {fileID: 215210002}
    characterRoot: {fileID: 89006033}
    characterImage: {fileID: 1613223483}
    characterShadow: {fileID: 97252308}
    autoSize: {fileID: 2034135709}
    popAnimation: {fileID: 2034135708}
    triangleAnimation: {fileID: 1285737013}
    animator: {fileID: 1613223482}
    shadowAnimator: {fileID: 97252307}
  dialogues:
  - text: I UNDERSTAND...
    speakerIndex: 1
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 1
    animatorStateName: SittingTalking2
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: f926626743443054ebfbabbf7acf4674, type: 3}
  - text: BUT THREE VACCINES IN ONE DAY STILL MAKES ME A LITTLE WORRIED.
    speakerIndex: 1
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 1
    endAnimatorStateName: Sitting2
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 5860a4319f6b715428a2cb66848d551d, type: 3}
  - text: NURSE IS IT OKAY FOR OUR BABY TO RECEIVE ALL OF THEM TODAY?
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 1
    animatorStateName: SittingTalking3
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 1
    endAnimatorStateName: Sitting2
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 1576f06ff7e93834aad36e2d51d2b5c5, type: 3}
  - text: YES.
    speakerIndex: 0
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 1
    animatorStateName: StandingTalking1
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 123c46587f50f5641bb404cf6662a1c3, type: 3}
  - text: THESE VACCINES ARE SCHEDULED FOR YOUR BABY'S AGE.
    speakerIndex: 0
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 016559b2fcea5534497c31c502cf6394, type: 3}
  - text: AND IS SAFE TO RECEIVE THEM ALL ON THE SAME DAY.
    speakerIndex: 0
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 21b0a27aa546a864abd2d1207ba6f796, type: 3}
  - text: ARE YOU READY?
    speakerIndex: 0
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 1
    endAnimatorStateName: Standing1
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 8300000, guid: 4c0c7e24502ee504890f6ddac617058e, type: 3}
  typingSpeed: 0.03
  voiceVolume: 1
