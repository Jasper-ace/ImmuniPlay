  fatherText: {fileID: 2020569184}
  dialogues:
  - dialogue: SIGH...
    isMotherTalking: 1
  - dialogue: 'MARIA, ARE YOU OKAY? '
    isMotherTalking: 0
  - dialogue: SHOULD WE REST?
    isMotherTalking: 0
  - dialogue: "IT\u2019S OKAY."
    isMotherTalking: 1
  - dialogue: "I\u2019M JUST... "
    isMotherTalking: 1
  - dialogue: A LITTLE NERVOUS.
    isMotherTalking: 1
  - dialogue: I WANT OUR BABY TO BE HEALTHY.
    isMotherTalking: 1
  - dialogue: AND BESIDES WE HAVE TO GO EARLY.
    isMotherTalking: 1
  - dialogue: ' I HAVE A PRENATAL CHECKUP SCHEDULED AT 9:00AM.'
    isMotherTalking: 1
  - dialogue: "DON\u2019T WORRY."
    isMotherTalking: 0
  - dialogue: YOU AND OUR BABY WILL DO GREAT.
    isMotherTalking: 0
  - dialogue: REMEMBER I WILL ALWAYS BE RIGHT BESIDE YOU.
    isMotherTalking: 0
  - dialogue: THANK YOU ANDREW FOR ALWAYS MAKING ME FEEL BETTER.
    isMotherTalking: 1
  nextButton: {fileID: 498244330}
  typingSpeed: 0.05
