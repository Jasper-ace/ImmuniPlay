  motherText: {fileID: 1831517793}
  npc1Bubble: {fileID: 2135978146}
  npc1Text: {fileID: 929341826}
  npc2Bubble: {fileID: 1545471575}
  npc2Text: {fileID: 1382948967}
  npc3Bubble: {fileID: 1307697653}
  npc3Text: {fileID: 1652453389}
  npc1Eye: {fileID: 1197362923}
  npc2Eye: {fileID: 2143237826}
  npc3Eye: {fileID: 60195698}
  conversations:
  - lines:
    - speaker: 0
      dialogue: WHAT HAPPENED TO YOUR CHILD?
    - speaker: 1
      dialogue: My baby has a high fever and cough.
    - speaker: 1
      dialogue: HE CAN'T SLEEP AND EAT WELL.
    - speaker: 1
      dialogue: I think he got infected with a disease.
    - speaker: 1
      dialogue: if only I hadn't delayed his vaccination.
  - lines:
    - speaker: 0
      dialogue: WHAT HAPPENED TO YOUR CHILD?
    - speaker: 2
      dialogue: She's been very tired and won't eat.
    - speaker: 2
      dialogue: her eyes looked a little yellow.
    - speaker: 2
      dialogue: My mother-in-law said vaccines would make her sick.
    - speaker: 2
      dialogue: I believed her.
    - speaker: 2
      dialogue: Now I regret that decision.
  - lines:
    - speaker: 0
      dialogue: WHAT HAPPENED TO YOUR CHILD?
    - speaker: 3
      dialogue: "I\u2019m not really sure."
    - speaker: 3
      dialogue: "My child suddenly developed rashes and a high fever.\_"
    - speaker: 3
      dialogue: I thought it would just go away on its own.
    - speaker: 3
      dialogue: But my family kept telling me to bring hER to the clinic.
