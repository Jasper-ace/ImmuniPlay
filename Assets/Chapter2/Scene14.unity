  m_EditorClassIdentifier: Assembly-CSharp::StoryFlowManager
  dialogueText: {fileID: 1268243582}
  dialogues:
  - 'CONGRATULATIONS, IT''S A HEALTHY BABY BOY. '
  - WHAT WOULD YOU LIKE TO NAME HIM?
  - Great! That's a wonderful name.
  - Here's your {baby} EPI Immunization Card.
  - This card RECORDS {baby} VACCINATIONS.
  - Please bring it during every vaccination visit.
  - Now it's time for {baby}  first vaccines.
  - the BCG vaccine and the Hepatitis B vaccine.
  - These vaccines are best given within 24 hours of birth.
  - BUT BEFORE WE START.
  - LET'S WATCH A SHORT VIDEO ABOUT THESE VACCINES.
  typingSpeed: 0.03
  babyIdentificationPanel: {fileID: 951949857}
  confirmButton: {fileID: 29710166}
