  content: {fileID: 1520194846}
  chatBubblePrefab: {fileID: 4519831632920879282, guid: 3c8a9175935fa754e8104ef7be6dd172, type: 3}
  chatScrollRect: {fileID: 944055821}
  playerMessageColor: {r: 0.09411766, g: 0.37647063, b: 0.9686275, a: 1}
  npcMessageColor: {r: 0.29803923, g: 0.29803923, b: 0.29803923, a: 1}
  typingIndicatorPrefab: {fileID: 4519831632920879282, guid: b2d6521c5b0a6364eb95b63fc2855d38, type: 3}
  typingIndicatorDuration: 1
  playerMessagePopSound: {fileID: 8300000, guid: bf0461bbda955b140a6191a81b14a369, type: 3}
  playerMessagePopVolume: 0.1
  npcMessagePopSound: {fileID: 8300000, guid: bf0461bbda955b140a6191a81b14a369, type: 3}
  npcMessagePopVolume: 0.1
  messageDelay: 1
  exchanges:
  - playerMessages:
    - message: Good morning, Nurse Ana.
    npcMessages:
    - message: Good morning, Andrew how may I help you?
  - playerMessages:
    - message: We're a little worried, our neighbor said that vaccines gives us the
        disease they're supposed to prevent.
    - message: Is this true?
    npcMessages:
    - message: There are many myths and false information spreading among people.
    - message: That's why it's very important to rely on information from trusted
        healthcare professionals.
  - playerMessages:
    - message: I see.
    npcMessages:
    - message: How about this.
    - message: 'I''m going to provide some statements about vaccines. '
    - message: and let's see how well you can tell the difference between what is
        a myth and what is a fact.
  chatButton: {fileID: 548800662}
  mythFactManager: {fileID: 736931771}
