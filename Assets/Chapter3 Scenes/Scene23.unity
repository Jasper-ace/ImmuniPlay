  dialogues:
  - speaker: 0
    text: WHY DID YOU VACCINATE YOUR CHILD?
    facing: 0
  - speaker: 0
    text: DON'T YOU KNOW THAT VACCINE COULD BE THE CAUSE OF HIS FEVER?
    facing: 0
  - speaker: 1
    text: BUT ACCORDING TO THE PEDIATRICIAN A MILD FEVER IS NORMAL.
    facing: 0
  - speaker: 1
    text: 'IT MEANS THAT THE BODY IS BUILDING PROTECTION AGAINST THE DISEASE. '
    facing: 0
  - speaker: 1
    text: AND USUALLY GOES AWAY AFTER PROPER CARE.
