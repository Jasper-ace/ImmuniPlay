  - characterName: FATHER
    dialogueBubble: {fileID: 110089667}
    dialogueText: {fileID: 110089666}
    characterRoot: {fileID: 1120886547}
    characterImage: {fileID: 1001282382}
    characterShadow: {fileID: 1598633685}
    autoSize: {fileID: 110089665}
    popAnimation: {fileID: 110089664}
    triangleAnimation: {fileID: 110089662}
    animator: {fileID: 1001282381}
    shadowAnimator: {fileID: 1598633687}
  - characterName: DOC ZAMORA
    dialogueBubble: {fileID: 2063778781}
    dialogueText: {fileID: 2063778780}
    characterRoot: {fileID: 823416612}
    characterImage: {fileID: 1409659819}
    characterShadow: {fileID: 1297713886}
    autoSize: {fileID: 2063778779}
    popAnimation: {fileID: 2063778778}
    triangleAnimation: {fileID: 2063778776}
    animator: {fileID: 1409659818}
    shadowAnimator: {fileID: 1297713883}
  - characterName: NURSE ANA
    dialogueBubble: {fileID: 1018498479}
    dialogueText: {fileID: 1018498478}
    characterRoot: {fileID: 725884799}
    characterImage: {fileID: 1667285645}
    characterShadow: {fileID: 497419172}
    autoSize: {fileID: 1018498477}
    popAnimation: {fileID: 1018498476}
    triangleAnimation: {fileID: 1018498474}
    animator: {fileID: 1667285644}
    shadowAnimator: {fileID: 497419174}
  dialogues:
  - text: I WANT TO DELAY THE VACCINES FOR NOW.
    speakerIndex: 0
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: I UNDERSTAND...
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: IT'S NORMAL FOR PARENTS TO HAVE CONCERNS ABOUT THEIR BABY'S FIRST VACCINES.
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: BUT THESE VACCINES ARE REQUIRED AFTER BIRTH.
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: THEY SHOULD BE GIVEN WITHIN 24 HOURS OF BIRTH.
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: WHY CAN'T WE JUST WAIT?
    speakerIndex: 1
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: WAITING WOULD DELAY THE PROTECTION THESE VACCINES PROVIDE EARLY IN YOUR
      BABY'S LIFE.
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: I SEE...
    speakerIndex: 1
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: LET'S GIVE YOUR BABY THE PROTECTION HE NEEDS.
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: NURSE ANA, WE CAN NOW PROCEED WITH THE VACCINES.
    speakerIndex: 2
    reverseCharacterX: 0
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 0
    animatorStateName: 
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 0
    endAnimatorStateName: 
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  - text: YES DOC.
    speakerIndex: 3
    reverseCharacterX: 1
    reverseCharacterXOnDialogueFinish: 0
    playAnimatorState: 1
    animatorStateName: StandingTalkingHappy1
    useAnimatorTrigger: 0
    animatorTriggerName: 
    playEndAnimatorState: 1
    endAnimatorStateName: StandingHappy1
    useEndAnimatorTrigger: 0
    endAnimatorTriggerName: 
    voiceClip: {fileID: 0}
  typingSpeed: 0.035
  voiceVolume: 1
  startAutomatically: 1
